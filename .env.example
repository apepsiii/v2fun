# .env.example - Configuration for V2Fun Backend API

# Telegram Bot Configuration (Optional)
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Get chat ID from @userinfobot or your chat
TELEGRAM_CHAT_ID=-1001234567890

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=5001
API_DEBUG=false
# Set a strong API key to protect Backend API endpoints (Authorization: Bearer <key> or X-API-Key)
BACKEND_API_KEY=change-me-to-a-strong-random-key
# Comma-separated allowed CORS origins (default: *)
CORS_ORIGINS=http://localhost:5000,http://localhost:5001

# Web UI Configuration
FLASK_SECRET_KEY=change-me-to-a-strong-random-secret
FLASK_DEBUG=false

# Model Priority (comma-separated, best to worst)
MODEL_PRIORITY=nano-banana-pro,gpt-image-2,nano-banana-2,nano-banana-2-lite,qwen-edit

# Job Settings
MAX_CONCURRENT_JOBS=10
JOB_TIMEOUT=300
STATUS_CHECK_INTERVAL=5

# Account Pool Settings
ACCOUNT_RELOAD_INTERVAL=3600
MIN_ACCOUNTS_REQUIRED=1

# Continuous Token Auto-Refresh (renews JWT via headless OAuth every 1 hour)
ENABLE_TOKEN_AUTO_REFRESH=true
TOKEN_REFRESH_INTERVAL_HOURS=1
TOKEN_REFRESH_BEFORE_HOURS=12
TOKEN_REFRESH_FORCE=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=v2fun_data/backend_api.log
